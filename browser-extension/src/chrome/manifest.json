{
  "name": "Morphs.io chrome extension",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*morphic:*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://morphs.io/*"],
      "js": ["handshake.js"],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "88"
}
