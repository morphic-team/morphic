{
  "name": "Morphs.io extension",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@morphs.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*morphic:*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://morphs.io/*"],
      "js": ["handshake.js"],
      "run_at": "document_start"
    }
  ]
}
